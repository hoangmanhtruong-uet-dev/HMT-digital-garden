# --- Aiven MySQL Connection Details ---
# Bạn lấy thông tin kết nối từ Aiven Console -> Connection information
DB_URL=jdbc:mysql://HOST:PORT/DATABASE?sslMode=REQUIRED&serverTimezone=UTC
DB_USER=avnadmin
DB_PASS=YOUR_AIVEN_PASSWORD

# --- Gemini API Key ---
# Nhận key tại: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Admin authentication ---
ADMIN_PIN=CHANGE_THIS_ADMIN_PIN

# --- Cloudinary (lưu ảnh upload vĩnh viễn) ---
# Đăng ký miễn phí tại: https://cloudinary.com
# Lấy credentials tại: Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# --- Production profile ---
# Bật profile prod để khoá ddl-auto ở mức validate (không tự đổi schema)
SPRING_PROFILES_ACTIVE=prod

# --- CORS / WebSocket origin whitelist ---
# Ở production liệt kê domain thật, phân tách bằng dấu phẩy
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- (Tùy chọn) Passcode WebSocket /ws-location ---
# Đặt giá trị để bắt buộc client truyền header "passcode" khi CONNECT.
# Để trống nếu tính năng location dùng công khai.
WS_PASSCODE=
